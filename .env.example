# Hosted Supabase project must be created in the team's account.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
MLFLOW_TRACKING_URI=file:research/artifacts/mlruns
# Full raw/processed data on the teammate's large local drive.
# Empty means <repo>/research/data. Export this variable or copy into .env.
RURALMED_DATA_ROOT=
